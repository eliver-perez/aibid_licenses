{
  "name": "aidex/license-server",
  "description": "Panel y servidor independiente de licencias AIDEX",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "ext-gd": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-sodium": "*",
    "ext-xmlwriter": "*",
    "bacon/bacon-qr-code": "^3.0",
    "dompdf/dompdf": "^3.1.6",
    "spomky-labs/otphp": "^11.3"
  },
  "require-dev": { "phpunit/phpunit": "^12.0" },
  "autoload": { "psr-4": { "Aibid\\": "src/" } },
  "autoload-dev": { "psr-4": { "Aibid\\Tests\\": "tests/" } },
  "config": { "sort-packages": true, "allow-plugins": false },
  "scripts": {
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration",
    "test:contract": "php contracts/v1/generate-fixtures.php --check",
    "test": ["@test:unit", "@test:integration"]
  }
}
