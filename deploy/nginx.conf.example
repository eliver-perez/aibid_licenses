# Include from nginx's http{} context (e.g. sites-enabled/).
# Configure domain, certificate paths and the dedicated PHP-FPM socket before enabling.
map $request_id $aibid_correlation_id {
    "~^([0-9a-f]{8})([0-9a-f]{4})([0-9a-f]{4})([0-9a-f]{4})([0-9a-f]{12})$" "$1-$2-$3-$4-$5";
    default "00000000-0000-4000-8000-000000000000";
}
server {
    listen 443 ssl;
    server_name licencias.example.com;
    root /srv/aibidlicense/current/public;
    server_tokens off;
    ssl_certificate /etc/letsencrypt/live/licencias.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/licencias.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 96k;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control "no-store" always;

    location ^~ /v1/ {
        client_max_body_size 16k;
        error_page 413 = @api_too_large;
        error_page 429 = @api_rate_limited;
        error_page 500 502 503 504 = @api_unavailable;
        if (-f /srv/aibidlicense/shared/maintenance.flag) { return 503; }
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param HTTPS on;
        fastcgi_pass unix:/run/php/aibidlicense.sock;
        fastcgi_intercept_errors off;
        fastcgi_hide_header X-Powered-By;
        fastcgi_read_timeout 60s;
    }
    location @api_too_large {
        default_type application/json;
        return 413 '{"error":{"code":"INVALID_REQUEST","message":"La solicitud supera el tamaño permitido.","request_id":"$aibid_correlation_id"}}';
    }
    location @api_rate_limited {
        default_type application/json;
        # Preserve security headers here because add_header inheritance is all-or-nothing.
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control "no-store" always;
        add_header Retry-After "60" always;
        return 429 '{"error":{"code":"RATE_LIMITED","message":"Demasiadas solicitudes.","request_id":"$aibid_correlation_id"}}';
    }
    location @api_unavailable {
        default_type application/json;
        return 503 '{"error":{"code":"TEMPORARY_UNAVAILABLE","message":"El servicio no está disponible temporalmente.","request_id":"$aibid_correlation_id"}}';
    }
    location ~ /\. { deny all; }
    location ~ \.php(?:/|$) { return 404; }
    location /assets/ { try_files $uri =404; }
    location / {
        if (-f /srv/aibidlicense/shared/maintenance.flag) { return 503; }
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param HTTPS on;
        fastcgi_pass unix:/run/php/aibidlicense.sock;
        fastcgi_hide_header X-Powered-By;
        fastcgi_read_timeout 60s;
    }
}
