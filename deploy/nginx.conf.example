server {
    listen 443 ssl;
    server_name licencias.example.com;
    root /srv/aibidlicense/current/public;
    index index.php;

    # Configure certificate/key paths managed by your TLS tooling.
    ssl_certificate /etc/letsencrypt/live/licencias.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/licencias.example.com/privkey.pem;
    client_max_body_size 64k;

    location / { try_files $uri /index.php$is_args$args; }
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param HTTPS on;
        fastcgi_pass unix:/run/php/aibidlicense.sock;
    }
    location ~ \.php$ { return 404; }
    location ~ /\. { deny all; }
}
