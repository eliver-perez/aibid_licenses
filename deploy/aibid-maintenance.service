[Unit]
Description=AIBID session cleanup, audit anchor and encrypted backup
After=mysql.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/flock -n /srv/aibidlicense/backup/maintenance.lock /usr/local/sbin/aibid-maintenance
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/aibidlicense/backup
