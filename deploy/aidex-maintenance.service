[Unit]
Description=AIDEX session cleanup, audit anchor and encrypted backup
After=mysql.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/flock -n /srv/aidexlicense/backup/maintenance.lock /usr/local/sbin/aidex-maintenance
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/aidexlicense/backup
